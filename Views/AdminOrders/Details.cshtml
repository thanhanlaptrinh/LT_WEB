@model LTW09.Models.ShopOrder
@{
    ViewData["Title"] = $"Đơn {Model.OrderCode}";
    string[] statusFlow = { "Pending", "Confirmed", "Preparing", "Shipping", "Completed" };

    string StatusLabel(string s) => s switch {
        "Pending"   => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Preparing" => "Đang chuẩn bị",
        "Shipping"  => "Đang giao",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã hủy",
        _           => s
    };
    string StatusColor(string s) => s switch {
        "Pending"   => "#e65100",
        "Confirmed" => "#1565c0",
        "Preparing" => "#6a1b9a",
        "Shipping"  => "#00695c",
        "Completed" => "#2e7d32",
        "Cancelled" => "#999",
        _           => "#555"
    };
}

<section class="section" style="background:var(--paper);min-height:80vh;">
    <div class="container" style="max-width:760px;">
        <p class="section-label">QUẢN TRỊ → ĐƠN HÀNG</p>
        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
            <h1 style="font-size:1.8rem;margin:0;font-family:'Playfair Display',serif;">@Model.OrderCode</h1>
            <span style="font-size:.8rem;font-weight:700;color:@StatusColor(Model.Status);">
                ● @StatusLabel(Model.Status)
            </span>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background:#e8f5e9;border-left:4px solid #4caf50;padding:.9rem 1.2rem;margin-bottom:1.2rem;font-size:.84rem;">
                ✓ @TempData["Success"]
            </div>
        }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem;">
            @* Thông tin nhận hàng *@
            <div style="border:1px solid var(--line);padding:1.2rem;">
                <p class="section-label" style="margin-bottom:.8rem;">NGƯỜI NHẬN</p>
                <p style="font-size:.84rem;margin:.4rem 0;"><strong>@Model.RecipientName</strong></p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">📞 @Model.RecipientPhone</p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">📍 @Model.DeliveryAddress</p>
                @if (Model.DeliveryDate.HasValue)
                {
                    <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">📅 @Model.DeliveryDate.Value.ToString("dd/MM/yyyy")</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CardMessage))
                {
                    <p style="font-size:.84rem;margin:.8rem 0 0;font-style:italic;color:var(--leaf);">"@Model.CardMessage"</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
                {
                    <p style="font-size:.8rem;margin:.5rem 0 0;color:var(--muted);">Ghi chú: @Model.CustomerNote</p>
                }
            </div>

            @* Thông tin đơn *@
            <div style="border:1px solid var(--line);padding:1.2rem;">
                <p class="section-label" style="margin-bottom:.8rem;">THÔNG TIN ĐƠN</p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">Ngày đặt: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">Thanh toán: <strong>@(Model.PaymentMethod == "BankTransfer" ? "Chuyển khoản VietQR" : "Tiền mặt khi nhận hoa (COD)")</strong></p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">Tạm tính: <strong>@Model.Subtotal.ToString("N0") ₫</strong></p>
                <p style="font-size:.84rem;margin:.4rem 0;color:var(--muted);">Phí giao: <strong>@(Model.DeliveryFee == 0 ? "Miễn phí" : Model.DeliveryFee.ToString("N0") + " ₫")</strong></p>
                <p style="font-size:1rem;margin:.8rem 0 0;font-weight:700;color:var(--leaf);">Tổng: @Model.TotalAmount.ToString("N0") ₫</p>
            </div>
        </div>

        @* Danh sách sản phẩm *@
        <p class="section-label" style="margin-bottom:.8rem;">SẢN PHẨM</p>
        @foreach (var item in Model.Items)
        {
            <div style="display:grid;grid-template-columns:54px 1fr auto;gap:.7rem;align-items:center;padding:.7rem 0;border-bottom:1px solid var(--line);">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.ProductName" style="width:54px;height:58px;object-fit:cover;" />
                }
                else
                {
                    <div style="width:54px;height:58px;background:var(--sage);"></div>
                }
                <div>
                    <div style="font-size:.84rem;font-weight:600;">@item.ProductName</div>
                    <div style="font-size:.72rem;color:var(--muted);">@item.Quantity × @item.UnitPrice.ToString("N0") ₫</div>
                </div>
                <strong style="font-size:.84rem;color:var(--leaf);">@item.LineTotal.ToString("N0") ₫</strong>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }
        @* Cập nhật trạng thái *@
        @if (Model.Status != "Completed" && Model.Status != "Cancelled")
        {
            <div style="margin-top:2rem;border-top:1px solid var(--line);padding-top:1.5rem;">
                <p class="section-label" style="margin-bottom:.8rem;">CẬP NHẬT TRẠNG THÁI</p>
                <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
                    @foreach (var s in statusFlow)
                    {
                        if (Array.IndexOf(statusFlow, s) <= Array.IndexOf(statusFlow, Model.Status)) { continue; }
                        <form method="post" asp-action="UpdateStatus" asp-controller="AdminOrders" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <input type="hidden" name="newStatus" value="@s" />
                            <button type="submit" class="btn btn-petal"
                                    style="padding:.55rem .9rem;font-size:.75rem;">
                                → @StatusLabel(s)
                            </button>
                        </form>
                    }
                    <form method="post" asp-action="UpdateStatus" asp-controller="AdminOrders" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="newStatus" value="Cancelled" />
                        <button type="submit" class="btn"
                                style="padding:.55rem .9rem;font-size:.75rem;border:1px solid var(--rose);color:var(--rose);"
                                onclick="return confirm('Hủy đơn này? Tồn kho sẽ được hoàn lại.')">
                            Hủy đơn
                        </button>
                    </form>
                </div>
            </div>
        }

        <div style="margin-top:1.5rem;">
            <a asp-action="Index" asp-controller="AdminOrders"
               style="font-size:.78rem;color:var(--leaf);font-weight:600;">← Danh sách đơn hàng</a>
        </div>
    </div>
</section>
