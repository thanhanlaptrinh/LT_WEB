@model IEnumerable<LTW09.Models.ShopOrder>
@{
    ViewData["Title"] = "Quản lý đơn hàng — Lá & Nụ";
    var statuses = ViewBag.Statuses as Dictionary<string, string> ?? new Dictionary<string, string>
    {
        { "Pending", "Chờ xác nhận" },
        { "Confirmed", "Đã xác nhận" },
        { "Preparing", "Đang cắm hoa" },
        { "Shipping", "Đang giao hàng" },
        { "Completed", "Đã hoàn tất" },
        { "Cancelled", "Đã hủy" }
    };
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentSearch = ViewBag.CurrentSearch as string;

    string StatusColor(string s) => s switch {
        "Pending"   => "#e65100",
        "Confirmed" => "#1565c0",
        "Preparing" => "#6a1b9a",
        "Shipping"  => "#00695c",
        "Completed" => "#2e7d32",
        "Cancelled" => "#999",
        _           => "#555"
    };
}

<section class="section" style="background:var(--paper);min-height:80vh;padding-top:3.5rem;">
    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
            <div>
                <p class="section-label">QUẢN LÝ VẬN HÀNH</p>
                <h1 style="font-size:2rem;margin:0;">Xử lý đơn hàng</h1>
                <p style="font-size:.8rem;color:var(--muted);margin-top:.2rem;">
                    Tiếp nhận, xác nhận và cập nhật tiến trình cắm hoa & giao hoa đến khách hàng.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="AdminProducts" asp-action="Index"
                   class="btn btn-sm btn-outline-dark" style="border-radius:0;font-size:.78rem;">
                    ← Quản lý sản phẩm & Kho
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-controller="AdminUsers" asp-action="Index"
                       class="btn btn-sm btn-outline-danger" style="border-radius:0;font-size:.78rem;">
                        👥 Phân quyền
                    </a>
                }
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background:#e8f5e9;border-left:4px solid #4caf50;padding:.9rem 1.2rem;margin-bottom:1.2rem;font-size:.84rem;">
                ✓ @TempData["Success"]
            </div>
        }

        <!-- Bộ lọc tìm kiếm & trạng thái -->
        <form method="get" style="display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:1.5rem;align-items:center;">
            <input type="search" name="search" value="@currentSearch"
                   class="form-control" style="border-radius:0;max-width:240px;font-size:.8rem;"
                   placeholder="Tìm mã đơn / Tên / SĐT..." />

            <select name="status" class="form-select" style="border-radius:0;max-width:200px;font-size:.8rem;">
                <option value="">Tất cả trạng thái</option>
                @foreach (var s in statuses)
                {
                    <option value="@s.Key" selected="@(currentStatus == s.Key ? "selected" : null)">@s.Value</option>
                }
            </select>
            <button type="submit" class="btn btn-petal" style="padding:.55rem .9rem;font-size:.78rem;">Lọc danh sách</button>
            <a asp-action="Index" style="font-size:.78rem;color:var(--muted);text-decoration:none;">Xóa bộ lọc</a>
        </form>

        <div class="card border shadow-sm" style="border-radius:0;background:#fff;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:.82rem;">
                    <thead class="table-light">
                        <tr style="border-bottom:2px solid var(--line);text-align:left;">
                            <th style="padding:.6rem .8rem;">Mã đơn</th>
                            <th style="padding:.6rem .8rem;">Người nhận</th>
                            <th style="padding:.6rem .8rem;">Số điện thoại</th>
                            <th style="padding:.6rem .8rem;text-align:right;">Tổng tiền</th>
                            <th style="padding:.6rem .8rem;text-align:center;">Trạng thái</th>
                            <th style="padding:.6rem .8rem;">Ngày đặt</th>
                            <th style="padding:.6rem .8rem;text-align:center;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            var statusName = statuses.ContainsKey(o.Status) ? statuses[o.Status] : o.Status;
                            <tr>
                                <td style="padding:.6rem .8rem;font-weight:700;font-family:'Playfair Display',serif;color:var(--leaf);font-size:.9rem;">
                                    @o.OrderCode
                                </td>
                                <td style="padding:.6rem .8rem;">
                                    <strong>@o.RecipientName</strong>
                                    <div style="font-size:.7rem;color:var(--muted);max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @o.DeliveryAddress
                                    </div>
                                </td>
                                <td style="padding:.6rem .8rem;color:var(--ink);">@o.RecipientPhone</td>
                                <td style="padding:.6rem .8rem;text-align:right;font-weight:700;color:var(--leaf);">
                                    @o.TotalAmount.ToString("N0") ₫
                                </td>
                                <td style="padding:.6rem .8rem;text-align:center;">
                                    <span style="font-size:.75rem;font-weight:700;color:@StatusColor(o.Status);">
                                        ● @statusName
                                    </span>
                                </td>
                                <td style="padding:.6rem .8rem;color:var(--muted);white-space:nowrap;">
                                    @o.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                </td>
                                <td style="padding:.6rem .8rem;text-align:center;">
                                    <a asp-action="Details" asp-route-id="@o.OrderId"
                                       class="btn btn-sm btn-outline-dark" style="border-radius:0;font-size:.72rem;">
                                        Chi tiết & Cập nhật →
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" style="text-align:center;padding:2.5rem;color:var(--muted);">Chưa có đơn hàng nào khớp với điều kiện tìm kiếm.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
