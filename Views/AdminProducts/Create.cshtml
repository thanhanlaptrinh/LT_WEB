@model LTW09.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<section class="section" style="background:var(--paper);min-height:80vh;">
    <div class="container" style="max-width:680px;">
        <p class="section-label">QUẢN TRỊ → SẢN PHẨM</p>
        <h1 style="font-size:2rem;margin-bottom:1.5rem;">Thêm sản phẩm mới</h1>

        <form method="post" asp-action="Create" asp-controller="AdminProducts" novalidate>
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_ProductFormFields", Model)

            <div style="display:flex;gap:1rem;margin-top:1.5rem;flex-wrap:wrap;">
                <button type="submit" class="btn btn-petal">Lưu sản phẩm</button>
                <a asp-action="Index" class="btn" style="border:1px solid var(--line);padding:.82rem 1.12rem;font-size:.76rem;">← Hủy</a>
            </div>
        </form>
    </div>
</section>
