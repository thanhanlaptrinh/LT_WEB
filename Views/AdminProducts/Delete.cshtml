@model LTW09.Models.Product
@{
    ViewData["Title"] = "Ẩn sản phẩm";
}

<section class="section" style="background:var(--paper);min-height:70vh;">
    <div class="container" style="max-width:560px;">
        <p class="section-label">QUẢN TRỊ → SẢN PHẨM</p>
        <h1 style="font-size:2rem;margin-bottom:.75rem;">Ẩn sản phẩm</h1>
        <p style="color:var(--muted);font-size:.9rem;margin-bottom:1.5rem;">
            Sản phẩm sẽ được ẩn khỏi trang bán hàng. Lịch sử đơn hàng vẫn được giữ nguyên.
        </p>

        <div style="border:1px solid var(--line);padding:1.2rem;margin-bottom:1.5rem;display:flex;gap:1rem;align-items:center;">
            <img src="@Model.ImageUrl" alt="@Model.Name" style="width:64px;height:70px;object-fit:cover;" />
            <div>
                <strong style="font-size:.96rem;">@Model.Name</strong><br />
                <span style="font-size:.75rem;color:var(--muted);">@(Model.Category?.Name ?? "") · @Model.Price.ToString("N0") ₫</span>
            </div>
        </div>

        <form method="post" asp-action="Delete" asp-route-id="@Model.ProductId">
            @Html.AntiForgeryToken()
            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                <button type="submit" class="btn"
                        style="background:var(--rose);border-color:var(--rose);color:white;padding:.82rem 1.12rem;font-size:.76rem;">
                    Xác nhận ẩn
                </button>
                <a asp-action="Index" class="btn"
                   style="border:1px solid var(--line);padding:.82rem 1.12rem;font-size:.76rem;">
                    ← Hủy
                </a>
            </div>
        </form>
    </div>
</section>
