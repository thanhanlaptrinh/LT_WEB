@model LTW09.Models.ShopOrder
@{
    ViewData["Title"] = $"Đơn {Model.OrderCode} — Lá & Nụ";

    // Chuỗi trạng thái theo thứ tự
    var flow = new[] { "Pending", "Confirmed", "Preparing", "Shipping", "Completed" };
    var isCancelled = Model.Status == "Cancelled";
    var currentIndex = Array.IndexOf(flow, Model.Status);

    string StatusLabel(string s) => s switch {
        "Pending"   => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "Preparing" => "Đang chuẩn bị",
        "Shipping"  => "Đang giao hoa",
        "Completed" => "Giao thành công",
        "Cancelled" => "Đã hủy",
        _ => s
    };
    string StatusIcon(string s) => s switch {
        "Pending"   => "🕐",
        "Confirmed" => "✅",
        "Preparing" => "💐",
        "Shipping"  => "🚚",
        "Completed" => "🎉",
        "Cancelled" => "✕",
        _ => "·"
    };
    string StatusColor(string s) => s switch {
        "Pending"   => "#e65100",
        "Confirmed" => "#1565c0",
        "Preparing" => "#6a1b9a",
        "Shipping"  => "#00695c",
        "Completed" => "#2e7d32",
        "Cancelled" => "#999",
        _ => "var(--muted)"
    };
}

<section style="background:var(--cream);padding:3.5rem 0;min-height:70vh;">
    <div class="container" style="max-width:640px;">

        <div style="text-align:center;margin-bottom:2rem;">
            <span style="font-size:2rem;">@StatusIcon(Model.Status)</span>
            <p class="section-label" style="margin:.5rem 0 .2rem;">ĐƠN HÀNG</p>
            <h1 style="font-size:1.9rem;margin:0;font-family:'Playfair Display',serif;">
                @Model.OrderCode
            </h1>
            <p style="margin:.4rem 0 0;font-size:.9rem;font-weight:700;
                      color:@StatusColor(Model.Status);">
                @StatusLabel(Model.Status)
            </p>
        </div>

        @* ── Timeline trạng thái ─── *@
        @if (!isCancelled)
        {
            <div style="background:var(--paper);border:1px solid var(--line);
                        padding:1.5rem 1.8rem;margin-bottom:1.5rem;">
                <p class="section-label" style="margin-bottom:1.2rem;">TIẾN TRÌNH ĐƠN HÀNG</p>
                <div style="display:flex;align-items:flex-start;gap:0;position:relative;">
                    @for (int i = 0; i < flow.Length; i++)
                    {
                        var isDone    = i < currentIndex;
                        var isCurrent = i == currentIndex;
                        var dotColor  = isDone || isCurrent ? "var(--leaf)" : "var(--line)";
                        var textColor = isCurrent ? "var(--leaf)" : (isDone ? "var(--ink)" : "var(--muted)");
                        <div style="flex:1;text-align:center;position:relative;">
                            @* Đường nối *@
                            @if (i < flow.Length - 1)
                            {
                                <div style="position:absolute;top:10px;left:50%;width:100%;height:2px;
                                            background:@(isDone ? "var(--leaf)" : "var(--line)");
                                            z-index:0;"></div>
                            }
                            @* Dot *@
                            <div style="width:22px;height:22px;border-radius:50%;
                                        background:@dotColor;
                                        border:2px solid @dotColor;
                                        margin:0 auto;position:relative;z-index:1;
                                        display:flex;align-items:center;justify-content:center;">
                                @if (isDone)
                                {
                                    <span style="color:white;font-size:.65rem;font-weight:700;">✓</span>
                                }
                                else if (isCurrent)
                                {
                                    <div style="width:8px;height:8px;border-radius:50%;background:white;"></div>
                                }
                            </div>
                            @* Label *@
                            <p style="font-size:.6rem;font-weight:@(isCurrent ? "700" : "400");
                                      color:@textColor;margin:.45rem 0 0;line-height:1.3;">
                                @StatusLabel(flow[i])
                            </p>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="background:#fff5f4;border-left:4px solid var(--rose);
                        padding:1rem 1.3rem;margin-bottom:1.5rem;font-size:.84rem;color:var(--rose);">
                Đơn hàng này đã bị hủy. Vui lòng liên hệ tiệm nếu bạn cần hỗ trợ.
            </div>
        }

        @* ── Thông tin nhận hàng ─── *@
        <div style="background:var(--paper);border:1px solid var(--line);
                    padding:1.3rem 1.6rem;margin-bottom:1.2rem;">
            <p class="section-label" style="margin-bottom:.8rem;">THÔNG TIN NHẬN HOA</p>
            <div style="display:grid;gap:.4rem;font-size:.84rem;">
                <div style="display:flex;gap:1rem;">
                    <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                 text-transform:uppercase;letter-spacing:.06em;">Người nhận</span>
                    <strong>@Model.RecipientName</strong>
                </div>
                <div style="display:flex;gap:1rem;">
                    <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                 text-transform:uppercase;letter-spacing:.06em;">Điện thoại</span>
                    <span>@Model.RecipientPhone</span>
                </div>
                <div style="display:flex;gap:1rem;">
                    <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                 text-transform:uppercase;letter-spacing:.06em;">Địa chỉ</span>
                    <span>@Model.DeliveryAddress</span>
                </div>
                @if (Model.DeliveryDate.HasValue)
                {
                    <div style="display:flex;gap:1rem;">
                        <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                     text-transform:uppercase;letter-spacing:.06em;">Ngày giao</span>
                        <span>@Model.DeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CardMessage))
                {
                    <div style="display:flex;gap:1rem;margin-top:.3rem;">
                        <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                     text-transform:uppercase;letter-spacing:.06em;">Thiệp</span>
                        <em style="color:var(--leaf);">"@Model.CardMessage"</em>
                    </div>
                }
                <div style="display:flex;gap:1rem;border-top:1px solid var(--line);padding-top:.6rem;margin-top:.4rem;">
                    <span style="color:var(--muted);min-width:110px;font-size:.72rem;
                                 text-transform:uppercase;letter-spacing:.06em;">Ngày đặt</span>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        @* ── Danh sách sản phẩm ─── *@
        @if (Model.Items.Any())
        {
            <div style="background:var(--paper);border:1px solid var(--line);
                        padding:1.3rem 1.6rem;margin-bottom:1.2rem;">
                <p class="section-label" style="margin-bottom:.8rem;">HOA BẠN ĐÃ ĐẶT</p>
                @foreach (var item in Model.Items)
                {
                    <div style="display:grid;grid-template-columns:50px 1fr auto;
                                gap:.7rem;align-items:center;
                                padding:.6rem 0;border-bottom:1px solid var(--line);">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.ProductName"
                                 style="width:50px;height:54px;object-fit:cover;" />
                        }
                        else
                        {
                            <div style="width:50px;height:54px;background:var(--sage);"></div>
                        }
                        <div>
                            <div style="font-size:.84rem;font-weight:600;">@item.ProductName</div>
                            <div style="font-size:.7rem;color:var(--muted);">
                                x@item.Quantity · @item.UnitPrice.ToString("N0") ₫/bó
                            </div>
                        </div>
                        <strong style="font-size:.82rem;color:var(--leaf);">
                            @item.LineTotal.ToString("N0") ₫
                        </strong>
                    </div>
                }
                <div style="display:flex;justify-content:space-between;
                            font-size:.82rem;padding:.5rem 0;color:var(--muted);">
                    <span>Tạm tính</span><span>@Model.Subtotal.ToString("N0") ₫</span>
                </div>
                <div style="display:flex;justify-content:space-between;
                            font-size:.82rem;padding:.3rem 0;color:var(--muted);
                            border-bottom:1px solid var(--line);padding-bottom:.6rem;">
                    <span>Phí giao hàng</span>
                    <span>@(Model.DeliveryFee == 0 ? "Miễn phí" : Model.DeliveryFee.ToString("N0") + " ₫")</span>
                </div>
                <div style="display:flex;justify-content:space-between;
                            font-size:1rem;font-weight:700;padding:.7rem 0 0;">
                    <span>Tổng cộng</span>
                    <strong style="color:var(--leaf);">@Model.TotalAmount.ToString("N0") ₫</strong>
                </div>
            </div>
        }

        @* ── Hành động ─── *@
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.5rem;">
            <a href="/" class="btn btn-petal" style="flex:1;min-width:160px;text-align:center;">
                ← Về trang chủ
            </a>
            <a asp-action="Lookup" asp-controller="Orders"
               class="btn" style="flex:none;border:1px solid var(--line);
                                  padding:.82rem 1.12rem;font-size:.76rem;text-decoration:none;">
                Tra cứu đơn khác
            </a>
        </div>

        <p style="text-align:center;margin-top:1.3rem;font-size:.76rem;color:var(--muted);">
            Có thắc mắc về đơn hàng?
            <a href="tel:0378389006"
               style="color:var(--leaf);font-weight:600;text-decoration:none;">
                Gọi ngay 037 838 9006
            </a>
        </p>

    </div>
</section>
